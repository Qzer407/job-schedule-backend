# Development Environment Configuration
# 复制此文件为 .env 并修改对应的值

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=task_scheduler
DB_USERNAME=root
DB_PASSWORD=your_password_here

# XXL-JOB Configuration
XXL_JOB_ADMIN_ADDRESSES=http://127.0.0.1:8081/xxl-job-admin
XXL_JOB_EXECUTOR_APPNAME=job-scheduler-executor
XXL_JOB_EXECUTOR_IP=
XXL_JOB_EXECUTOR_PORT=9999
XXL_JOB_LOG_PATH=/tmp/xxl-job/jobhandler
XXL_JOB_LOG_RETENTION_DAYS=30
XXL_JOB_ACCESS_TOKEN=your_access_token_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRATION=86400000

# Logging
LOG_LEVEL=DEBUG
